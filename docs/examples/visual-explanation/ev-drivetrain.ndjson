{"version":1,"sessionID":"10000000-0000-4000-8000-000000000001","turnID":"30000000-0000-4000-8000-000000000004","sceneID":"20000000-0000-4000-8000-000000000003","sequence":0,"baseRevision":0,"revision":1,"beatID":"vehicle-battery","speech":{"chunkID":"vehicle-battery-speech","text":"This is a generic electric car, drawn see-through so you can look inside. The big flat battery pack sits in the floor, which keeps the weight low. It is an explanatory animation, not an engineering simulation."},"cues":[{"id":"show-car","anchor":{"kind":"start"},"operations":[{"op":"camera","camera":{"position":{"x":4.6,"y":2.4,"z":5.6},"target":{"x":-0.2,"y":0.45,"z":0},"fieldOfView":40}},{"op":"model","caption":"Generic EV, explanatory animation, not an engineering simulation","animationRate":1},{"op":"part","part":{"id":"shell","kind":"recipe","recipe":"carShell","transform":{"position":{"x":0,"y":0,"z":0},"rotation":{"x":0,"y":0,"z":0},"scale":{"x":1,"y":1,"z":1}},"accessibleDescription":"Simplified car body, shown translucent.","shell":true,"material":{"opacity":0.5}}},{"op":"part","part":{"id":"battery","kind":"recipe","recipe":"batteryPack","transform":{"position":{"x":0,"y":0.23,"z":0},"rotation":{"x":0,"y":0,"z":0},"scale":{"x":1,"y":1,"z":1}},"accessibleDescription":"Flat battery pack made of modules in a tray under the floor."}},{"op":"callout","callout":{"id":"battery-label","text":"Battery pack","partID":"battery","anchor":{"x":0,"y":0.5,"z":0.0}}}]}],"isFinal":false}
{"version":1,"sessionID":"10000000-0000-4000-8000-000000000001","turnID":"30000000-0000-4000-8000-000000000004","sceneID":"20000000-0000-4000-8000-000000000003","sequence":1,"baseRevision":1,"revision":2,"beatID":"inverter","speech":{"chunkID":"inverter-speech","text":"The inverter sits between the battery and the motor. It turns the battery's direct current into the three-phase alternating current the motor needs, and it sets how much torque you get."},"cues":[{"id":"show-inverter","anchor":{"kind":"start"},"operations":[{"op":"part","part":{"id":"inverter","kind":"recipe","recipe":"inverterBox","transform":{"position":{"x":-0.95,"y":0.46,"z":0},"rotation":{"x":0,"y":0,"z":0},"scale":{"x":1,"y":1,"z":1}},"accessibleDescription":"Inverter box with cooling fins between the battery and the motor."}},{"op":"callout","callout":{"id":"inverter-label","text":"Inverter","partID":"inverter","anchor":{"x":0,"y":0.4,"z":0.0}}}]}],"isFinal":false}
{"version":1,"sessionID":"10000000-0000-4000-8000-000000000001","turnID":"30000000-0000-4000-8000-000000000004","sceneID":"20000000-0000-4000-8000-000000000003","sequence":2,"baseRevision":2,"revision":3,"beatID":"motor-reduction","speech":{"chunkID":"motor-reduction-speech","text":"The motor turns that current into rotation, and a single reduction gear slows it down and multiplies the torque. Watch the energy markers travel from the battery, through the inverter, to the motor."},"cues":[{"id":"show-motor","anchor":{"kind":"start"},"operations":[{"op":"part","part":{"id":"motor","kind":"recipe","recipe":"motor","transform":{"position":{"x":-1.4,"y":0.33,"z":-0.3},"rotation":{"x":0,"y":0,"z":0},"scale":{"x":1,"y":1,"z":1}},"accessibleDescription":"Electric motor with a stator ring and a spinning rotor.","spin":{"radiansPerSecond":15,"axis":"z"}}},{"op":"part","part":{"id":"reduction","kind":"recipe","recipe":"reductionGear","transform":{"position":{"x":-1.26,"y":0.33,"z":0.04},"rotation":{"x":0,"y":0,"z":0},"scale":{"x":1,"y":1,"z":1}},"accessibleDescription":"Single-stage reduction gear with a small input gear and a large output gear.","spin":{"radiansPerSecond":15,"axis":"z"}}},{"op":"path","path":{"id":"power-path","points":[{"x":0.5,"y":0.31,"z":0},{"x":-0.55,"y":0.31,"z":0},{"x":-0.69,"y":0.46,"z":0},{"x":-1.21,"y":0.46,"z":0},{"x":-1.3,"y":0.46,"z":-0.3},{"x":-1.4,"y":0.56,"z":-0.3}]}},{"op":"flow","flow":{"id":"energy","pathID":"power-path","speed":0.9,"direction":"forward","count":6,"color":"cyan","active":true,"markerSize":0.08}},{"op":"callout","callout":{"id":"motor-label","text":"Motor","partID":"motor","anchor":{"x":0,"y":0.4,"z":0.0}}},{"op":"callout","callout":{"id":"reduction-label","text":"Reduction gear","partID":"reduction","anchor":{"x":0.1,"y":0.42,"z":0.0}}}]}],"isFinal":false}
{"version":1,"sessionID":"10000000-0000-4000-8000-000000000001","turnID":"30000000-0000-4000-8000-000000000004","sceneID":"20000000-0000-4000-8000-000000000003","sequence":3,"baseRevision":3,"revision":4,"beatID":"wheels","speech":{"chunkID":"wheels-speech","text":"The slow, strong rotation passes through the half-shafts to the wheels. The wheels turn in the direction the car is travelling, so the car moves forward."},"cues":[{"id":"show-wheels","anchor":{"kind":"start"},"operations":[{"op":"part","part":{"id":"half-shafts","kind":"recipe","recipe":"halfShafts","transform":{"position":{"x":-1.12,"y":0.33,"z":0},"rotation":{"x":0,"y":0,"z":0},"scale":{"x":1,"y":1,"z":1}},"accessibleDescription":"Left and right drive shafts.","spin":{"radiansPerSecond":-6,"axis":"z"}}},{"op":"part","part":{"id":"wheels-rear","kind":"recipe","recipe":"wheel","transform":{"position":{"x":-1.12,"y":0.33,"z":-0.85},"rotation":{"x":0,"y":0,"z":0},"scale":{"x":1,"y":1,"z":1}},"accessibleDescription":"Rear left and right wheels with tyres.","spin":{"radiansPerSecond":-6,"axis":"z"},"repeat":{"count":2,"offset":{"x":0,"y":0,"z":1.7}}}},{"op":"part","part":{"id":"wheels-front","kind":"recipe","recipe":"wheel","transform":{"position":{"x":1.68,"y":0.33,"z":-0.85},"rotation":{"x":0,"y":0,"z":0},"scale":{"x":1,"y":1,"z":1}},"accessibleDescription":"Front left and right wheels with tyres.","spin":{"radiansPerSecond":-6,"axis":"z"},"repeat":{"count":2,"offset":{"x":0,"y":0,"z":1.7}}}},{"op":"callout","callout":{"id":"wheels-label","text":"Wheels","partID":"wheels-rear","anchor":{"x":0,"y":0.55,"z":0.85}}}]}],"isFinal":false}
{"version":1,"sessionID":"10000000-0000-4000-8000-000000000001","turnID":"30000000-0000-4000-8000-000000000004","sceneID":"20000000-0000-4000-8000-000000000003","sequence":4,"baseRevision":4,"revision":5,"beatID":"regeneration","speech":{"chunkID":"regeneration-speech","text":"When you lift off or brake, the motor works as a generator. The wheels now drive the motor, and the energy markers reverse: they run from the motor back through the inverter into the battery, which recovers some energy."},"cues":[{"id":"reverse-flow","anchor":{"kind":"start"},"operations":[{"op":"edit","id":"energy","expectedRevision":4,"change":{"direction":"reverse","color":"green"}},{"op":"edit","id":"battery-label","expectedRevision":4,"change":{"text":"Battery pack (charging)"}}]}],"isFinal":true}
