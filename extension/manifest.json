{
  "manifest_version": 3,
  "name": "ZEUS",
  "description": "Lets the ZEUS Mac app read and act on pages you ask it about.",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "key": "",
  "background": {
    "service_worker": "dist/sw.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "ZEUS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
