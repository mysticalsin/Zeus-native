+        let underlying = NSError(
+            domain: NSURLErrorDomain,
+            code: NSURLErrorBadServerResponse,
+            userInfo: [
+                NSLocalizedDescriptionKey: "header xi-api-key \(sentinel) failed",
+                "xi-api-key": sentinel,
+            ]
