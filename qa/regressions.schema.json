{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mysticalsin/Zeus/qa/regressions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "regressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "failure": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "guard": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "function": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
              }
            },
            "required": [
              "file",
              "function"
            ]
          }
        },
        "required": [
          "id",
          "failure",
          "features",
          "check",
          "guard"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "policy",
    "regressions"
  ]
}
